{
  "name": "@alexanderfortin/pi-usage-lib",
  "version": "0.3.0",
  "description": "Shared library for Pi usage monitoring extensions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./datetime": {
      "types": "./dist/datetime.d.ts",
      "import": "./dist/datetime.js"
    }
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "pnpm run typecheck && pnpm run build:tsc",
    "build:tsc": "tsc",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/",
    "check": "pnpm run typecheck && pnpm run lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@alexanderfortin/semantic-release-keep-a-changelog": "^0.4.14",
    "@biomejs/biome": "^2.5.14",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.0.16",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "usage-monitoring",
    "api-quota"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shaftoe/pi-usage-lib"
  },
  "author": "Alexander Fortin",
  "license": "MIT"
}
